# ==============================================================================
# EdgarDiff Root Gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
backend/.venv/
frontend/.venv/

# ------------------------------------------------------------------------------
# Node.js & Next.js (Frontend)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.next/
*/.next/
out/
*/out/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo

# ------------------------------------------------------------------------------
# SEC Ingestion Data & Cache
# (Ignores large raw SEC HTML/XBRL cache, while preserving sample fixtures)
# ------------------------------------------------------------------------------
data/cache/*
!data/cache/.gitkeep
!data/cache/fixtures/
!data/cache/fixtures/**
!data/cache/sample_*
!data/cache/*.fixture.*
!data/cache/*.sample.*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.nyc_output/

# ------------------------------------------------------------------------------
# Operating System & IDE Configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
